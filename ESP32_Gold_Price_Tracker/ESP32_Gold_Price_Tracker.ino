String formatTime(const String& isoTime) { 
  struct tm tm; 
  char buf[20]; 
   
  // Parse the ISO time string
  sscanf(isoTime.c_str(), "%d-%d-%dT%d:%d:%d",  
         &tm.tm_year, &tm.tm_mon, &tm.tm_mday,  
         &tm.tm_hour, &tm.tm_min, &tm.tm_sec); 
   
  // Adjust years and months to standard tm struct format
  tm.tm_year -= 1900; 
  tm.tm_mon -= 1; 
   
  // Convert to time_t to allow time zone manipulation
  time_t rawtime = mktime(&tm);
  
  // Apply time zone offset (in seconds)
  rawtime += (TIMEZONE_OFFSET_HOURS * 3600) + (TIMEZONE_OFFSET_MINUTES * 60);
  
  // Convert back to tm struct with adjusted time
  struct tm* adjusted_tm = localtime(&rawtime);
   
  // Format time to HH:MM
  strftime(buf, sizeof(buf), "%H:%M", adjusted_tm); 
  return String(buf); 
} 

float fetchPrice(const char* url) {
  HTTPClient https;
  https.begin(url);
  
  int httpCode = https.GET();
  if (httpCode == HTTP_CODE_OK) {
    String payload = https.getString();
    StaticJsonDocument<512> doc;
    DeserializationError error = deserializeJson(doc, payload);
    
    https.end();
    return error ? 0 : doc["price"].as<float>();
  }
  
  https.end();
  return 0;
}

String fetchTime(const char* url) {
  HTTPClient https;
  https.begin(url);
  
  int httpCode = https.GET();
  if (httpCode == HTTP_CODE_OK) {
    String payload = https.getString();
    StaticJsonDocument<512> doc;
    DeserializationError error = deserializeJson(doc, payload);
    
    https.end();
    return error ? "" : formatTime(doc["updatedAt"].as<String>());
  }
  
  https.end();
  return "";
}

void setup() 
{
  Serial.begin(115200);
  
  pinMode(upLED, OUTPUT);
  pinMode(downLED, OUTPUT);

  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS))
  {
    Serial.println(F("SSD1306 allocation failed"));
    for (;;);
  }

  display.clearDisplay();                                                     //Clear the display
  display.setTextColor(SSD1306_WHITE);                                        //Set the text colour to white
  display.drawBitmap(0, 0, logo, 128, 64, WHITE);                             //Display bitmap from array
  display.display();
  delay(4000);

  display.clearDisplay();                                                     //Clear the display
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.println("Connecting to WiFi...");
  display.display();

  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED)
  {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi Connected");

  display.clearDisplay();
  display.println("Connected to:");
  display.print(ssid);
  display.display();
  delay(1500);
  display.clearDisplay();
  display.display();
}

void loop() 
{
  if (WiFi.status() != WL_CONNECTED) {
    displayError("WiFi Disconnected");
    return;
  }

  // Gold Display
  float goldPrice = fetchPrice(goldUrl);
  String goldTime = fetchTime(goldUrl);

  display.clearDisplay();
  display.setTextSize(1);
  printCenter("Gold Price", 0, 0);

  display.setTextSize(2);
  printCenter("$" + String(goldPrice, 2), 0, 25);
                                           
  display.setTextSize(1);
  printCenter(goldTime, 0, 55);
  display.display();
  
  delay(10000);

  // Silver Display
  float silverPrice = fetchPrice(silverUrl);
  String silverTime = fetchTime(silverUrl);

  display.clearDisplay();
  display.setTextSize(1);
  printCenter("Silver Price", 0, 0);

  display.setTextSize(2);
  printCenter("$" + String(silverPrice, 2), 0, 25);
                                           
  display.setTextSize(1);
  printCenter(silverTime, 0, 55);
  display.display();
  
  delay(10000);
}

void displayError(String message) {
  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(0,0);
  display.println("ERROR:");
  display.println(message);
  display.display();
}

void printCenter(const String buf, int x, int y)
{
  int16_t x1, y1;
  uint16_t w, h;
  display.getTextBounds(buf, x, y, &x1, &y1, &w, &h);
  display.setCursor((x - w / 2) + (128 / 2), y);
  display.print(buf);
}

